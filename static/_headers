/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'

/api/*
  Access-Control-Allow-Origin: https://yupitek.com
  Access-Control-Allow-Methods: GET, POST

/js/*
  Cache-Control: public, max-age=2592000, immutable

/css/*
  Cache-Control: public, max-age=2592000, immutable

/images/*
  Cache-Control: public, max-age=604800
